# Clé HMAC pour les jetons CSRF — générer une valeur aléatoire propre à chaque
# installation (ex: openssl rand -hex 32). Sans cette clé, l'appli retombe sur
# une clé de secours codée en dur dans config/db.php, ce qui affaiblit la
# protection CSRF pour quiconque a lu ce code source.
CSRF_KEY=changez_moi_avec_une_valeur_aleatoire_unique

# Base de données
DB_HOST=localhost
DB_NAME=gestion_bail
DB_USER=root
DB_PASS=votre_mot_de_passe

# Chemin mysqldump
MYSQLDUMP_PATH=C:\laragon\bin\mysql\mysql-8.4.3-winx64\bin\mysqldump.exe

# Email SMTP (laisser MAIL_USER vide pour désactiver l'envoi)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=votre_email@gmail.com
MAIL_PASS=votre_mot_de_passe_application
MAIL_FROM=votre_email@gmail.com
MAIL_FROM_NAME=BailManager
