# Bloquer l'accès direct au fichier .env
<Files ".env">
    Order allow,deny
    Deny from all
</Files>

# Bloquer l'accès aux fichiers de sauvegarde et de config exposés
<FilesMatch "\.(sql|log|bak|sh)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Désactiver la liste des répertoires
Options -Indexes

# Durcissement des cookies de session (portée à ce projet uniquement, sans
# toucher au php.ini partagé par les autres sites Laragon).
<IfModule php_module>
    php_flag session.cookie_httponly On
    php_value session.cookie_samesite Lax
    php_flag session.use_strict_mode On
</IfModule>
<IfModule mod_php.c>
    php_flag session.cookie_httponly On
    php_value session.cookie_samesite Lax
    php_flag session.use_strict_mode On
</IfModule>

# cookie_secure : activé automatiquement seulement si la requête est en HTTPS,
# pour ne jamais casser le déploiement local en HTTP actuel tout en se
# protégeant dès que le site passe en HTTPS (aucune modification à refaire).
<If "%{HTTPS} == 'on'">
    <IfModule php_module>
        php_flag session.cookie_secure On
    </IfModule>
    <IfModule mod_php.c>
        php_flag session.cookie_secure On
    </IfModule>
</If>
