# ─── BailManager 2 — configuration de l'installation ───────────────────────
# Copiez ce fichier en « .env » puis adaptez les valeurs.

# Clé secrète : remplacez par une longue chaîne aléatoire (python -c "import secrets;print(secrets.token_urlsafe(50))")
SECRET_KEY=remplacez-moi-par-une-longue-chaine-aleatoire
DEBUG=0
TIME_ZONE=Africa/Abidjan

# Adresses autorisées (* = toutes, pratique en réseau local)
ALLOWED_HOSTS=*
# Adresse publique de l'application (liens des e-mails de mot de passe oublié)
APP_URL=http://localhost:8000
# Mettre 1 uniquement derrière un certificat HTTPS (installation Cloud)
HTTPS=0
# Mettre 1 uniquement si un proxy (Nginx, hébergeur) est placé devant BailManager : son en-tête X-Forwarded-For
# donne alors l'adresse réelle des clients. En installation locale, laisser 0 (sinon l'en-tête pourrait être falsifié).
PROXY_DE_CONFIANCE=0
# Installation Cloud : adresse(s) HTTPS d'accès, séparées par des virgules
# CSRF_TRUSTED_ORIGINS=https://gestion.votre-agence.ci

# ─── Base de données ──────────────────────────────────────────────────────
# sqlite : aucun logiciel à installer (fichier bailmanager.sqlite3)
# mysql  : MySQL / MariaDB de WAMP, XAMPP, Laragon ou du serveur Cloud
DB_ENGINE=sqlite
DB_NAME=bailmanager
DB_USER=root
DB_PASS=
DB_HOST=localhost
DB_PORT=3306

# ─── Ancienne base PHP (uniquement pour l'import, voir docs/MIGRATION.md) ─
# LEGACY_DB_NAME=gestion_bail
# LEGACY_DB_USER=root
# LEGACY_DB_PASS=
# LEGACY_DB_HOST=localhost

# ─── E-mails (quittances, rappels, mot de passe oublié) — facultatif ──────
# Exemple Gmail : MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, mot de passe d'application
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_TLS=1
MAIL_FROM=BailManager <no-reply@votre-agence.ci>

# Dossiers (relatifs au dossier backend)
MEDIA_DIR=uploads
BACKUP_DIR=sauvegardes
